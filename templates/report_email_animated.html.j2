<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background-color: #f8fafc;
      padding: 32px;
      color: #334155;
      max-width: 960px;
      margin: auto;
    }

    h2 {
      text-align: center;
      color: #0f172a;
      font-size: 28px;
      margin-bottom: 32px;
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 10px;
    }

    .summary {
      text-align: center;
      margin-bottom: 30px;
      background-color: #f0fdfa;
      border: 1px solid #ccfbf1;
      padding: 10px 18px;
      border-radius: 8px;
      font-size: 14px;
      color: #0f766e;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
      background-color: #ffffff;
      border-radius: 10px;
      overflow: hidden;
    }

    th {
      background-color: #0f172a;
      color: #f8fafc;
      padding: 14px;
      font-size: 14px;
      text-align: center;
    }

    td {
      padding: 14px;
      font-size: 13px;
      text-align: center;
      border-bottom: 1px solid #f1f5f9;
    }

    tr:hover td {
      background-color: #f8fafc;
    }

    .hostname a {
      color: #0d9488;
      text-decoration: none;
      font-weight: bold;
    }

    .hostname a:hover {
      text-decoration: underline;
    }

    .bar-container {
      width: 100%;
      background-color: #e2e8f0;
      border-radius: 6px;
      height: 10px;
      overflow: hidden;
      margin-top: 4px;
    }

    .bar {
      height: 100%;
      border-radius: 6px;
    }

    .cpu-bar { background-color: #f43f5e; }
    .mem-bar { background-color: #3b82f6; }
    .disk-bar { background-color: #10b981; }

    .metric-val {
      font-weight: 600;
      color: #1e293b;
      font-size: 13px;
      margin-bottom: 2px;
    }

    .badge {
      font-size: 11px;
      padding: 4px 10px;
      border-radius: 12px;
      display: inline-block;
      font-weight: 600;
    }

    .healthy {
      background-color: #d1fae5;
      color: #065f46;
    }
    
    .warning {
      background-color: #fef3c7;
      color: #92400e;
    }
    
    .critical {
      background-color: #fee2e2;
      color: #991b1b;
    }

    .footer {
      text-align: center;
      font-size: 12px;
      margin-top: 24px;
      color: #64748b;
    }
  </style>
</head>
<body>
  <h2>📊 Consolidated VM Health Report</h2>

  <div class="summary">
    📅 <b>{{ collected_metrics | length }} VMs</b> | 🔥 Avg CPU: {{ ((collected_metrics | map(attribute='cpu') | map('float') | sum | float) / (collected_metrics | length)) | round(2) }}% | 📥 Avg Mem: {{ ((collected_metrics | map(attribute='mem') | map('float') | sum | float) / (collected_metrics | length)) | round(2) }}% | 📦 Avg Disk: {{ ((collected_metrics | map(attribute='disk') | map('float') | sum | float) / (collected_metrics | length)) | round(2) }}%
  </div>

  <table>
    <tr>
      <th style="width: 25%;">🌐 Hostname</th>
      <th style="width: 15%;">🩺 Status</th>
      <th style="width: 20%;">🔥 CPU Usage</th>
      <th style="width: 20%;">📥 Memory Usage</th>
      <th style="width: 20%;">📦 Disk Usage</th>
    </tr>
    {% for vm in collected_metrics %}
    <tr>
      <td class="hostname">
        <a href="http://{{ vm.hostname }}" target="_blank">{{ vm.hostname }}</a>
      </td>
      <td>
        {% set cpu_f = vm.cpu | float %}
        {% set mem_f = vm.mem | float %}
        {% set disk_f = vm.disk | float %}
        {% if cpu_f >= 80 or mem_f >= 80 or disk_f >= 80 %}
          <div class="badge critical">Critical</div>
        {% elif cpu_f >= 50 or mem_f >= 50 or disk_f >= 50 %}
          <div class="badge warning">Warning</div>
        {% else %}
          <div class="badge healthy">Healthy</div>
        {% endif %}
      </td>
      <td>
        <div class="metric-val">{{ vm.cpu }}%</div>
        <div class="bar-container"><div class="bar cpu-bar" style="width: {{ vm.cpu }}%"></div></div>
      </td>
      <td>
        <div class="metric-val">{{ vm.mem }}%</div>
        <div class="bar-container"><div class="bar mem-bar" style="width: {{ vm.mem }}%"></div></div>
      </td>
      <td>
        <div class="metric-val">{{ vm.disk }}%</div>
        <div class="bar-container"><div class="bar disk-bar" style="width: {{ vm.disk }}%"></div></div>
      </td>
    </tr>
    {% endfor %}
  </table>

  <div class="footer">
    ⏱️ Report Generated on: {{ timestamp }}
  </div>
</body>
</html>
